# =============================================================================
# iOS Targets
# =============================================================================

# iOS Device (ARM64)
[target.aarch64-apple-ios]
rustflags = ["-C", "link-arg=-isysroot", "-C", "link-arg=/Applications/Xcode.app/Contents/Developer/Platforms/iPhoneOS.platform/Developer/SDKs/iPhoneOS.sdk"]

# iOS Simulator (ARM64 - Apple Silicon Macs)
[target.aarch64-apple-ios-sim]
rustflags = ["-C", "link-arg=-isysroot", "-C", "link-arg=/Applications/Xcode.app/Contents/Developer/Platforms/iPhoneSimulator.platform/Developer/SDKs/iPhoneSimulator.sdk"]

# iOS Simulator (x86_64 - Intel Macs)
[target.x86_64-apple-ios]
rustflags = ["-C", "link-arg=-isysroot", "-C", "link-arg=/Applications/Xcode.app/Contents/Developer/Platforms/iPhoneSimulator.platform/Developer/SDKs/iPhoneSimulator.sdk"]

# =============================================================================
# Android Targets
# Update the NDK paths below to match your local Android SDK installation.
# Replace <NDK_VERSION> with your installed NDK version (e.g., 28.2.13676358).
# =============================================================================

# Windows:
[target.aarch64-linux-android]
linker = "C:\\Users\\<USERNAME>\\AppData\\Local\\Android\\Sdk\\ndk\\<NDK_VERSION>\\toolchains\\llvm\\prebuilt\\windows-x86_64\\bin\\aarch64-linux-android21-clang.cmd"

[target.armv7-linux-androideabi]
linker = "C:\\Users\\<USERNAME>\\AppData\\Local\\Android\\Sdk\\ndk\\<NDK_VERSION>\\toolchains\\llvm\\prebuilt\\windows-x86_64\\bin\\armv7a-linux-androideabi21-clang.cmd"

[target.x86_64-linux-android]
linker = "C:\\Users\\<USERNAME>\\AppData\\Local\\Android\\Sdk\\ndk\\<NDK_VERSION>\\toolchains\\llvm\\prebuilt\\windows-x86_64\\bin\\x86_64-linux-android21-clang.cmd"

# macOS/Linux (uncomment and use these instead):
# [target.aarch64-linux-android]
# linker = "/Users/<USERNAME>/Library/Android/sdk/ndk/<NDK_VERSION>/toolchains/llvm/prebuilt/darwin-x86_64/bin/aarch64-linux-android21-clang"
#
# [target.armv7-linux-androideabi]
# linker = "/Users/<USERNAME>/Library/Android/sdk/ndk/<NDK_VERSION>/toolchains/llvm/prebuilt/darwin-x86_64/bin/armv7a-linux-androideabi21-clang"
#
# [target.x86_64-linux-android]
# linker = "/Users/<USERNAME>/Library/Android/sdk/ndk/<NDK_VERSION>/toolchains/llvm/prebuilt/darwin-x86_64/bin/x86_64-linux-android21-clang"
